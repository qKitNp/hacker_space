{
  "manifest_version": 3,
  "name": "Hacker Space",
  "version": "1.3.0",
  "description": "Replace your new tab with a random Hacker News story and a short AI summary.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-bookmark": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "Quick bookmark the current Hacker Space story (Alt+B / Option+B)"
    }
  },
  "permissions": [],
  "host_permissions": [
    "https://hn.tinkerers.space/*",
    "https://hacker-news.firebaseio.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
